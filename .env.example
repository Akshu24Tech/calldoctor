# Copy to .env for local use. On Render, set these as environment variables.

# Free LLM for the simulator, the judge, and the agent on LiveKit/Vapi → console.groq.com
GROQ_API_KEY=

# Shared secret. Goes in every webhook URL (?token=...) and unlocks the dashboard's Run button.
CALLDOCTOR_TOKEN=change-me

# Where CallDoctor is deployed, e.g. https://calldoctor-xxxx.onrender.com (used by the deploy scripts)
PUBLIC_URL=

# Optional: Postgres for persistent storage (free at neon.tech). Empty = local SQLite in data/.
DATABASE_URL=

# Optional model overrides (Groq model ids)
# AGENT_MODEL=llama-3.3-70b-versatile
# CALLER_MODEL=llama-3.1-8b-instant
# JUDGE_MODEL=llama-3.3-70b-versatile

# --- Only needed to deploy the agent to the voice platforms
VAPI_API_KEY=
RETELL_API_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SARVAM_API_KEY=
